def _personal_mark() -> list[str]:
    path = os.path.expanduser("~/.config/fastfetch/linus_art.txt")
    try:
        raw = open(path, encoding="utf-8").read().splitlines()
    except OSError:
        return []
    return [line.rstrip() for line in raw if line.strip()]


