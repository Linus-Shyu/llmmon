  llmmon                      读取 ~/.config/llmmon/host，并在下面显示这台 MacBook
  llmmon user@mac             直接指定那台机器，同时显示这台 MacBook
  llmmon --local              只监控本机
  llmmon --once               打一行就退出
  ./install.sh user@mac       装到本机，并装到那台机器

按键
  q 退出    b 测一次 tok/s    空格 暂停

配置文件只有一行，例如 user@192.168.1.20
也可以用环境变量 LLMMON_HOST。
"""


def host_from_args(args: list[str]) -> str:
    if "--host" in args:
        index = args.index("--host")
        if index + 1 < len(args):
            return args[index + 1].strip()
    for arg in args:
        if arg.startswith("--host="):
            return arg.split("=", 1)[1].strip()
        if arg.startswith("-"):
            continue
        if "@" in arg:
            return arg
    return ""


def host_from_config() -> str:
    env = os.environ.get("LLMMON_HOST", "").strip()
    if env:
        return env
    path = os.path.expanduser("~/.config/llmmon/host")
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except OSError:
        return ""
    for line in lines:
        line = line.strip()
        if line and not line.startswith("#"):
            return line
    return ""


def main(argv: list[str]) -> int:
    args = argv[1:]
    if "--help" in args or "-h" in args:
        print(usage())
        return 0
    if "--serve-http" in args:
        serve_http()
        return 0
    if "--serve" in args:
        serve()
        return 0
    explicit = host_from_args(args)
    local = "--local" in args or (is_mini() and not explicit)
    once = "--once" in args
    if local:
        engine = Engine()
        engine.snapshot()
        time.sleep(0.15)
        if once:
            print_once(engine.snapshot())
            engine.stop()
            return 0
        run_tui(engine, "http://127.0.0.1:11434/v1")
        return 0
    url = "" if "--ssh" in args else monitor_file("url")
    if url and not local:
        view = PublicView(url)
        if once or not sys.stdout.isatty():
            return once_remote_view(view)
        run_tui(view, url, Engine())
        return 0
    host = explicit or host_from_config()
    if not host:
        if not sys.stdout.isatty() or once:
            print(usage(), file=sys.stderr)
            return 2
        run_tui(Idle(), "llmmon user@mac")
        return 0
    link = f"ssh -L 11435:127.0.0.1:11434 {host}"
    if once or not sys.stdout.isatty():
        return once_remote_view(RemoteView(host))
    run_tui(RemoteView(host), link, Engine())
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except KeyboardInterrupt:
        print("\033[?25h\033[?1049l", end="")
        raise SystemExit(130)
