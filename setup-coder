#!/bin/sh
# Pick a coding model that fits this Mac, install it with Ollama,
# and connect OpenCode so it can edit files and run commands.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin}"

dry=0
here=0
model_only=0
apply=0
host=""
upstream_url=""

usage() {
  cat << 'EOF'
按这台 Mac 的内存选择模型，装好，并接上能改文件、跑命令的工具。

  ./setup-coder                 模型和工具都装在这台 Mac
  ./setup-coder user@mac        模型装在那台 Mac，并让它开隧道
  ./setup-coder --upstream URL  模型已经在这个地址上，只接本机工具
  ./setup-coder --apply         更新本机 OpenCode、代理和 minicode，不重装模型
  ./setup-coder --dry-run       只打印会选哪个模型

装完后，进入项目目录运行 minicode。
EOF
}

while [ $# -gt 0 ]; do
  case $1 in
    --dry-run) dry=1; shift ;;
    --here) here=1; shift ;;
    --model-only) model_only=1; shift ;;
    --apply) apply=1; shift ;;
    --upstream) upstream_url=${2:-}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *@*) host=$1; shift ;;
    *)
      echo "不认识的参数: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

ssh_to() {
  ssh -T \
    -o BatchMode=yes \
    -o ConnectTimeout=8 \
    -o GSSAPIAuthentication=no \
    -o PreferredAuthentications=publickey \
    -o LogLevel=ERROR \
    "$@"
}

choose_model() {
  mem_bytes=$1
  mem_gb=$((mem_bytes / 1024 / 1024 / 1024))
  if [ "$mem_gb" -lt 12 ]; then
    MODEL_TAG=qwen2.5-coder:3b
    NUM_CTX=8192
    REASON="内存不到 12GB。7B 会把系统挤进交换区，所以用 3B。"
  elif [ "$mem_gb" -lt 24 ]; then
    MODEL_TAG=qwen3.5:9b
    NUM_CTX=16384
    REASON="12–23GB 放得下 9B Q4（约 6GB），并留出系统和 16384 上下文。它会自己调用工具。"
  elif [ "$mem_gb" -lt 48 ]; then
    MODEL_TAG=qwen2.5-coder:14b
    NUM_CTX=8192
    REASON="24–47GB 可以放 14B Q4。上下文用 8192，避免 KV 把内存吃满。"
  else
    MODEL_TAG=qwen2.5-coder:32b
    NUM_CTX=16384
    REASON="48GB 及以上才放得下 32B Q4。"
  fi
}

read_machine() {
  MEM_BYTES=$(sysctl -n hw.memsize)
  MACHINE=$(sysctl -n hw.model 2>/dev/null || echo Mac)
  MEM_GB=$((MEM_BYTES / 1024 / 1024 / 1024))
}

print_choice() {
  where=$1
  echo "$where"
  echo "  机型   $MACHINE"
  echo "  内存   ${MEM_GB}GB"
  echo "  模型   $MODEL_TAG"
  echo "  上下文 $NUM_CTX"
  echo "  $REASON"
}

install_ollama_env() {
  plist=$HOME/Library/LaunchAgents/homebrew.mxcl.ollama.plist
  [ -f "$plist" ] || return 0
  /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables" "$plist" >/dev/null 2>&1 \
    || /usr/libexec/PlistBuddy -c "Add :EnvironmentVariables dict" "$plist"
  set_env() {
    key=$1
    val=$2
    if /usr/libexec/PlistBuddy -c "Print :EnvironmentVariables:$key" "$plist" >/dev/null 2>&1; then
      /usr/libexec/PlistBuddy -c "Set :EnvironmentVariables:$key $val" "$plist"
    else
      /usr/libexec/PlistBuddy -c "Add :EnvironmentVariables:$key string $val" "$plist"
    fi
  }
  set_env OLLAMA_FLASH_ATTENTION 1
  set_env OLLAMA_KV_CACHE_TYPE q8_0
  set_env OLLAMA_KEEP_ALIVE -1
  set_env OLLAMA_MAX_LOADED_MODELS 1
  set_env OLLAMA_NUM_PARALLEL 1
  set_env OLLAMA_HOST 127.0.0.1:11434
  set_env OLLAMA_GPU_OVERHEAD 1073741824
  uid=$(id -u)
  launchctl bootout "gui/$uid/homebrew.mxcl.ollama" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$uid" "$plist"
}

wait_ollama() {
  i=0
  while [ "$i" -lt 40 ]; do
    if curl -sf -m 1 http://127.0.0.1:11434/api/version >/dev/null 2>&1; then
      return 0
    fi
    i=$((i + 1))
    sleep 0.5
  done
  echo "Ollama 没有在 127.0.0.1:11434 起来。" >&2
  return 1
}

deploy_model() {
  if ! command -v brew >/dev/null 2>&1; then
    echo "需要 Homebrew 才能安装 Ollama。" >&2
    exit 1
  fi
  if ! command -v ollama >/dev/null 2>&1; then
    brew install ollama
  fi
  brew services start ollama >/dev/null 2>&1 || true
  install_ollama_env
  wait_ollama
  ollama pull "$MODEL_TAG"
  mkdir -p "$HOME/llm"
  case $MODEL_TAG in
    qwen2.5-coder:*)
      cat > "$HOME/llm/Modelfile" << EOF
FROM $MODEL_TAG
PARAMETER num_ctx $NUM_CTX
PARAMETER temperature 0.2
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.05
EOF
      ;;
    *)
      printf 'FROM %s\nPARAMETER num_ctx %s\n' "$MODEL_TAG" "$NUM_CTX" > "$HOME/llm/Modelfile"
      ;;
  esac
  ollama create coder -f "$HOME/llm/Modelfile"
  ollama stop coder >/dev/null 2>&1 || true
  echo "模型 coder 已就绪（来自 ${MODEL_TAG}）。"
}

write_plist() {
  path=$1
  label=$2
  body=$3
  mkdir -p "$(dirname "$path")"
  cat > "$path" << EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
$body
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
EOF
}

bootstrap_agent() {
  label=$1
  plist=$2
  uid=$(id -u)
  launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$uid" "$plist"
}

install_proxy() {
  upstream=$1
  mkdir -p "$HOME/.config/minicode"
  cp "$ROOT/minicode-proxy.py" "$HOME/.config/minicode/proxy.py"
  chmod 755 "$HOME/.config/minicode/proxy.py"
  if [ -x /opt/homebrew/bin/python3 ]; then
    py=/opt/homebrew/bin/python3
  elif [ -x /usr/bin/python3 ]; then
    py=/usr/bin/python3
  else
    py=$(command -v python3)
  fi
  plist=$HOME/Library/LaunchAgents/com.llmmon.minicode.proxy.plist
  write_plist "$plist" com.llmmon.minicode.proxy "  <key>ProgramArguments</key>
  <array>
    <string>$py</string>
    <string>$HOME/.config/minicode/proxy.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MINICODE_UPSTREAM</key>
    <string>$upstream</string>
  </dict>"
  bootstrap_agent com.llmmon.minicode.proxy "$plist"
}

install_tunnel() {
  remote=$1
  plist=$HOME/Library/LaunchAgents/com.llmmon.minicode.tunnel.plist
  write_plist "$plist" com.llmmon.minicode.tunnel "  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-L</string>
    <string>11435:127.0.0.1:11434</string>
    <string>-o</string>
    <string>ExitOnForwardFailure=yes</string>
    <string>-o</string>
    <string>BatchMode=yes</string>
    <string>-o</string>
    <string>ConnectTimeout=6</string>
    <string>-o</string>
    <string>GSSAPIAuthentication=no</string>
    <string>-o</string>
    <string>PreferredAuthentications=publickey</string>
    <string>-o</string>
    <string>ServerAliveInterval=15</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <string>-o</string>
    <string>LogLevel=ERROR</string>
    <string>$remote</string>
  </array>"
  bootstrap_agent com.llmmon.minicode.tunnel "$plist"
}

INSTRUCTION='Do only what the user asked. A folder request is only mkdir. Install libraries from the project: Python uses .venv and pip, Node uses npm. Do not write Hello World or open a browser unless they asked for a page. When they ask for a file, call write and then bash. Python is already installed as python3. Never install Python unless they asked for a Python toolchain.'

install_opencode() {
  if ! command -v opencode >/dev/null 2>&1; then
    brew install anomalyco/tap/opencode-v2
  fi
  mkdir -p "$HOME/.config/opencode"
  python3 - "$HOME/.config/opencode/opencode.json" "$INSTRUCTION" << 'PY'
import json, sys
from pathlib import Path

path = Path(sys.argv[1])
instruction = sys.argv[2]
data = {}
if path.exists():
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        data = {}
if not isinstance(data, dict):
    data = {}
data["$schema"] = "https://opencode.ai/config.json"
data["model"] = data.get("model") or "mini/coder"
data["skills"] = []
data["instructions"] = [instruction]
perm = data.get("permission") if isinstance(data.get("permission"), dict) else {}
perm.pop("execute", None)
perm.update(
    {
        "skill": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "subagent": "deny",
        "question": "deny",
        "external_directory": "allow",
    }
)
data["permission"] = perm
providers = data.get("providers") if isinstance(data.get("providers"), dict) else {}
mini = providers.get("mini") if isinstance(providers.get("mini"), dict) else {}
mini["name"] = mini.get("name") or "Local coder"
mini["package"] = "@opencode/ai/providers/openai-compatible"
settings = mini.get("settings") if isinstance(mini.get("settings"), dict) else {}
settings["baseURL"] = "http://127.0.0.1:11436/v1"
settings["apiKey"] = settings.get("apiKey") or "ollama"
mini["settings"] = settings
models = mini.get("models") if isinstance(mini.get("models"), dict) else {}
coder = models.get("coder") if isinstance(models.get("coder"), dict) else {}
coder["modelID"] = "coder"
coder["name"] = coder.get("name") or "coder"
caps = coder.get("capabilities") if isinstance(coder.get("capabilities"), dict) else {}
caps["tools"] = True
caps["input"] = ["text"]
caps["output"] = ["text"]
coder["capabilities"] = caps
limit = coder.get("limit") if isinstance(coder.get("limit"), dict) else {}
limit["context"] = max(int(limit.get("context") or 0), 16384)
limit["output"] = max(int(limit.get("output") or 0), 8192)
coder["limit"] = limit
models["coder"] = coder
mini["models"] = models
providers["mini"] = mini
data["providers"] = providers
path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}

stash_client_files() {
  mkdir -p "$HOME/.config/minicode" "$HOME/bin"
  for name in setup-coder minicode minicode-proxy.py llmmon; do
    src="$ROOT/$name"
    dest="$HOME/.config/minicode/$name"
    if [ -f "$src" ] && [ ! "$src" -ef "$dest" ]; then
      cp "$src" "$dest"
    fi
  done
}

detect_native() {
  python3 - "$HOME/.config/minicode/upstream" "$HOME/.config/minicode/native" << 'PY'
import json, os, sys, urllib.request
upstream_file, flag = sys.argv[1], sys.argv[2]
try:
    base = open(upstream_file, encoding="utf-8").read().strip()
except OSError:
    base = ""
base = (base or "http://127.0.0.1:11434").rstrip("/")
req = urllib.request.Request(base + "/api/show", data=json.dumps({"model": "coder"}).encode(),
                             headers={"Content-Type": "application/json", "User-Agent": "minicode"})
try:
    with urllib.request.urlopen(req, timeout=6) as resp:
        info = json.loads(resp.read())
except Exception:
    sys.exit(0)
arch = str((info.get("model_info") or {}).get("general.architecture") or (info.get("details") or {}).get("family") or "")
if arch in ("qwen2", "llama"):
    if os.path.exists(flag):
        os.remove(flag)
else:
    open(flag, "a").close()
PY
}

apply_client() {
  stash_client_files
  install_opencode
  install_launcher
  detect_native
  if [ -f "$ROOT/minicode-proxy.py" ]; then
    if ! cmp -s "$ROOT/minicode-proxy.py" "$HOME/.config/minicode/proxy.py" 2>/dev/null; then
      cp "$ROOT/minicode-proxy.py" "$HOME/.config/minicode/proxy.py"
      chmod 755 "$HOME/.config/minicode/proxy.py"
      if [ -f "$HOME/Library/LaunchAgents/com.llmmon.minicode.proxy.plist" ]; then
        bootstrap_agent com.llmmon.minicode.proxy "$HOME/Library/LaunchAgents/com.llmmon.minicode.proxy.plist"
      fi
    fi
  fi
  if [ -f "$ROOT/llmmon" ]; then
    mkdir -p "$HOME/bin"
    cp "$ROOT/llmmon" "$HOME/bin/llmmon"
    chmod 755 "$HOME/bin/llmmon"
    if [ -w /opt/homebrew/bin ]; then
      ln -sfn "$HOME/bin/llmmon" /opt/homebrew/bin/llmmon
    fi
  fi
}

install_launcher() {
  mkdir -p "$HOME/bin" /usr/local/bin
  cp "$ROOT/minicode" "$HOME/bin/minicode"
  chmod 755 "$HOME/bin/minicode"
  if [ -w /opt/homebrew/bin ]; then
    ln -sfn "$HOME/bin/minicode" /opt/homebrew/bin/minicode
  fi
  if [ -w /usr/local/bin ]; then
    ln -sfn "$HOME/bin/minicode" /usr/local/bin/minicode
  fi
  case ":${PATH:-}:" in
    *":$HOME/bin:"*) ;;
    *)
      echo "把这一行加进 ~/.zshrc 后新开一个终端窗口："
      echo "  export PATH=\"\$HOME/bin:\$PATH\""
      ;;
  esac
}

install_tools() {
  upstream=$1
  remote=${2:-}
  stash_client_files
  install_opencode
  if [ -n "$remote" ]; then
    install_tunnel "$remote"
    install_proxy "http://127.0.0.1:11435"
  else
    install_proxy "$upstream"
  fi
  install_launcher
  detect_native
  echo "工具已接上。进入项目目录后运行: minicode"
}

deploy_remote() {
  remote=$1
  echo "读取 $remote 的内存……"
  spec=$(ssh_to "$remote" 'printf "%s %s\n" "$(sysctl -n hw.memsize)" "$(sysctl -n hw.model)"')
  MEM_BYTES=${spec%% *}
  MACHINE=${spec#* }
  MEM_GB=$((MEM_BYTES / 1024 / 1024 / 1024))
  choose_model "$MEM_BYTES"
  print_choice "将在 $remote 上安装模型"
  if [ "$dry" -eq 1 ]; then
    echo "这台 Mac 只安装工具，通过 SSH 隧道使用那边的模型。"
    exit 0
  fi
  ssh_to "$remote" 'mkdir -p "$HOME/.config/minicode"'
  scp -o BatchMode=yes -o ConnectTimeout=8 -o GSSAPIAuthentication=no -o PreferredAuthentications=publickey \
    "$ROOT/setup-coder" "$ROOT/minicode-proxy.py" "$ROOT/minicode" "$ROOT/serve.sh" "$ROOT/tunnel.sh" "$ROOT/llmmon" \
    "$remote:.config/minicode/"
  ssh_to "$remote" 'export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH; sh "$HOME/.config/minicode/setup-coder" --here --model-only'
  monitor=$(ssh_to "$remote" 'grep -v "^#" "$HOME/.config/llmmon/url" | head -1' || true)
  token=$(ssh_to "$remote" 'grep -v "^#" "$HOME/.config/llmmon/token" | head -1' || true)
  upstream=$(ssh_to "$remote" 'grep -v "^#" "$HOME/.config/minicode/upstream" | head -1' || true)
  if [ -n "$monitor" ] && [ -n "$upstream" ]; then
    install_tools "$upstream"
    if [ -x "$ROOT/install.sh" ]; then
      "$ROOT/install.sh" --url "$monitor" --token "$token"
    fi
    echo "已改走隧道，不再开 SSH 转发。"
    return 0
  fi
  echo "隧道没有起来，改用 SSH 转发。"
  install_tools "http://127.0.0.1:11434" "$remote"
  if [ -x "$ROOT/install.sh" ]; then
    "$ROOT/install.sh" "$remote"
  fi
}

if [ "$apply" -eq 1 ]; then
  apply_client
  echo "本机 minicode 已更新。进入项目目录后运行: minicode"
  exit 0
fi

if [ -n "$upstream_url" ]; then
  install_tools "$upstream_url"
  exit 0
fi

if [ -n "$host" ] && [ "$here" -eq 0 ]; then
  deploy_remote "$host"
  exit 0
fi

read_machine
choose_model "$MEM_BYTES"
print_choice "将在这台 Mac 上安装"
if [ "$dry" -eq 1 ]; then
  exit 0
fi
deploy_model
if [ -f "$ROOT/serve.sh" ]; then
  sh "$ROOT/serve.sh"
fi
if [ "$model_only" -eq 0 ]; then
  install_tools "http://127.0.0.1:11434"
fi
