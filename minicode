#!/bin/sh
# Start a coding session in the current directory.
# The model is reached through the local tool proxy.
set -eu

# Apple's Terminal quits while drawing this screen (CoreText font fallback,
# EXC_ARM_PAC_FAIL). Warp draws its own text, so hand the session over.
if [ "${TERM_PROGRAM:-}" = "Apple_Terminal" ] && [ "${MINICODE_WARP:-}" != 1 ]; then
  if [ ! -d /Applications/Warp.app ]; then
    echo "Apple 的终端画这个界面会崩溃。请换 Warp 或 iTerm 后再运行 minicode。" >&2
    exit 1
  fi
  if [ -x /opt/homebrew/bin/minicode ]; then
    bin=/opt/homebrew/bin/minicode
  elif [ -x "$HOME/bin/minicode" ]; then
    bin=$HOME/bin/minicode
  else
    bin=$0
  fi
  cfg="$HOME/.config/minicode/warp-launch.yaml"
  mkdir -p "$HOME/.config/minicode"
  python3 - "$cfg" "$(pwd)" "$bin" "$@" << 'PY'
import shlex, sys
cfg, cwd, *args = sys.argv[1:]

def y(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'

cmd = "MINICODE_WARP=1 " + " ".join(shlex.quote(a) for a in args)
open(cfg, "w").write(
    "---\n"
    "name: minicode\n"
    "windows:\n"
    "  - tabs:\n"
    "      - title: minicode\n"
    "        layout:\n"
    f"          cwd: {y(cwd)}\n"
    "          commands:\n"
    f"            - exec: {y(cmd)}\n"
)
PY
  encoded=$(python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' "$cfg")
  open "warp://launch/$encoded"
  echo "Apple 的终端画这个界面会崩溃，已经改到 Warp 里打开。"
  exit 0
fi

uid=$(id -u)
agents="$HOME/Library/LaunchAgents"
upstream_file="$HOME/.config/minicode/upstream"

eval "set -- $(python3 -c '
import shlex, sys
skip = {"mini", "--mini", "macmini", "local", "--local", "here", "macbook"}
print(" ".join(shlex.quote(a) for a in sys.argv[1:] if a not in skip))
' "$@")"

start_agent() {
  label=$1
  plist=$agents/$label.plist
  [ -f "$plist" ] || return 0
  if launchctl print "gui/$uid/$label" >/dev/null 2>&1; then
    return 0
  fi
  launchctl bootstrap "gui/$uid" "$plist"
}

mkdir -p "$HOME/.config/minicode"
printf '%s\n' "$(pwd)" > "$HOME/.config/minicode/cwd"
if [ -x "$HOME/.config/minicode/setup-coder" ]; then
  sh "$HOME/.config/minicode/setup-coder" --apply >/dev/null 2>&1 || true
fi
if [ ! -s "$upstream_file" ]; then
  echo "把模型地址写进 $upstream_file" >&2
  exit 1
fi
launchctl bootout "gui/$uid/com.llmmon.minicode.tunnel" >/dev/null 2>&1 || true
start_agent com.llmmon.minicode.proxy

ready=0
i=0
while [ "$i" -lt 8 ]; do
  if curl -sf -m 8 http://127.0.0.1:11436/v1/models >/dev/null 2>&1; then
    ready=1
    break
  fi
  i=$((i + 1))
  sleep 0.5
done

if [ "$ready" -ne 1 ]; then
  echo "模型没有连上。确认那台 Mac 开着，并且 cloudflared 在跑。" >&2
  exit 1
fi

if [ -x /opt/homebrew/bin/opencode ]; then
  exec /opt/homebrew/bin/opencode --standalone "$@"
fi
if command -v opencode >/dev/null 2>&1; then
  exec opencode --standalone "$@"
fi
echo "没有找到 opencode。先跑一次 ./setup-coder。" >&2
exit 1
